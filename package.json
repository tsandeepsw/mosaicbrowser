{
  "name": "mosaicbrowser",
  "version": "1.0.0",
  "desktopName": "mosaic.desktop",
  "private": true,
  "description": "Multi-panel workspace browser with isolated browsing contexts and customizable layouts.",
  "main": "apps/desktop/dist/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "build": {
    "appId": "com.mosaic.browser",
    "productName": "Mosaic",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "apps/desktop/package.json",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
        "target": "nsis",
        "arch": ["x64"]
        }
      ]
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": [
         "AppImage",
         "tar.gz"
      ],
      "category": "Network;WebBrowser;"
    }
  },
  "scripts": {
    "build": "npm run build --workspace=@workspacebrowser/types && npm run build --workspace=@workspacebrowser/storage && npm run build --workspace=@workspacebrowser/desktop",
    "start": "npm run build && npx electron apps/desktop/dist/main/index.js",
    "test": "vitest run",
    "test:e2e": "npm run build && cd apps/desktop && npx playwright test",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder && electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win && electron-builder install-app-deps",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux && electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "bindings": "^1.5.0",
    "file-uri-to-path": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
